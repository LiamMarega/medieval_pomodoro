<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#2E1D11"> <!-- Deep brown background -->

    <!-- Header: Title and Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/icon_placeholder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/session_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Focus Session"
                android:textColor="#D4AF37" 
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/session_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session 1"
                android:textColor="#F5E6D3"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25:00"
            android:textColor="#F5E6D3"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <!-- Pause/Resume Button -->
        <Button
            android:id="@+id/btn_toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pause"
            android:textColor="#2E1D11"
            android:backgroundTint="#D4AF37"
            android:layout_marginEnd="8dp" />

        <!-- Skip Button -->
        <Button
            android:id="@+id/btn_skip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Skip"
            android:textColor="#F5E6D3"
            android:backgroundTint="#6B4226"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
